# Segredos — NUNCA commitar chaves de API (football-data.org, API-Football, etc.)
.env
.env.*
*.key
secrets.*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Dados — cache de coleta é reproduzível (ignorar); reference é versionado (manter)
# data/raw/: ignora tudo, EXCETO os caches pequenos e caros de recoletar (SofaScore ~0,9 MB,
# football-data ~0,2 MB). StatsBomb (~1 GB) fica de fora: reinstalável, ver README.
data/raw/*
!data/raw/sofascore/
!data/raw/footballdata/
data/processed/*
!data/reference/
# logs de pré-registro (não re-deriváveis): versionados como carimbo de tempo das previsões
!data/processed/predictions_log.csv
!data/processed/counts_predictions_log.csv

# SO / editor
.DS_Store
.idea/
.vscode/
